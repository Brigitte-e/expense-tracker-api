// use prisma-next

enum Bank {
  @@type("pg/text@1")
  REVOLUT
  MONOBANK
  PRIVAT
}

enum ImportStatus {
  @@type("pg/text@1")
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionType {
  @@type("pg/text@1")
  INCOME
  EXPENSE
}

model User {
  id           Uuid              @id @default(uuid())
  email        String            @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())

  accounts      Account[]
  categories    Category[]
  categoryRules CategoryRule[]
  imports       Import[]
  transactions  Transaction[]

  @@map("users")
}

model Account {
  id        Uuid              @id @default(uuid())
  name      String
  bank      Bank
  currency  String
  createdAt TimestamptzString @default(now())

  userId Uuid
  user     User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        Uuid              @id @default(uuid())
  name      String
  createdAt TimestamptzString @default(now())

  userId Uuid
  user         User           @relation(fields: [userId], references: [id])
  transactions Transaction[]
  rules        CategoryRule[]

  @@unique([userId, name])
  @@map("categories")
}

model CategoryRule {
  id       Uuid   @id @default(uuid())
  pattern  String
  priority Int    @default(0)

  userId     Uuid
  categoryId Uuid
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, pattern])
  @@map("category_rules")
}

model Import {
  id        Uuid              @id @default(uuid())
  fileName  String
  bank      Bank
  status    ImportStatus
  createdAt TimestamptzString @default(now())

  userId Uuid
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@map("imports")
}

model Transaction {
  id              Uuid              @id @default(uuid())
  date            TimestamptzString
  description     String
  merchant        String?
  amount          Numeric(19, 4)
  currency        String
  type            TransactionType
  transactionHash String            @unique
  createdAt       TimestamptzString @default(now())

  userId     Uuid
  categoryId Uuid
  accountId  Uuid
  importId   Uuid?

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  import   Import?  @relation(fields: [importId], references: [id])

  @@index([userId, date])
  @@index([accountId, date])
  @@check(expression: "amount > 0", name: "transaction_amount_positive")
  @@map("transactions")
}
